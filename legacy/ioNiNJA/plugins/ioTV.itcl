namespace eval ::ioNiNJA::ioTVDB {
    namespace import -force ::ioNiNJA::*
    variable Cache {}
    variable HttpsRegistered 0
}

source [file join [file dirname [info script]] ioTV.cfg]

proc ::ioNiNJA::ioTVDB::dict_get {data key {default "N/A"}} {
    if {[dict exists $data $key]} {
        set value [dict get $data $key]
        if {$value ne ""} {return $value}
    }
    return $default
}

proc ::ioNiNJA::ioTVDB::json_get {json key {default ""}} {
    set pattern [format {"%s"[ \t\r\n]*:[ \t\r\n]*"((?:\\.|[^"\\])*)"} $key]
    if {[regexp $pattern $json -> value]} {
        return [string map [list "\\\"" "\"" "\\/" "/" "\\n" "\n" "\\r" "\r" "\\t" "\t" "\\\\" "\\"] $value]
    }
    return $default
}

proc ::ioNiNJA::ioTVDB::json_to_dict {json} {
    if {![catch {package require json}]} {
        return [::json::json2dict $json]
    }
    set result {}
    foreach key {
        Response Error Title Year Rated Released Runtime Genre Director Writer
        Actors Plot Language Country Awards Poster imdbRating imdbVotes imdbID
        Type totalSeasons Season Episode seriesID
    } {
        dict set result $key [json_get $json $key "N/A"]
    }
    return $result
}

proc ::ioNiNJA::ioTVDB::load_api_key {} {
    global ioTVDB
    if {[string trim $ioTVDB(omdb_api_key)] ne ""} {
        return [string trim $ioTVDB(omdb_api_key)]
    }
    if {![file exists $ioTVDB(omdb_api_key_file)]} {return ""}

    set handle [open $ioTVDB(omdb_api_key_file) r]
    fconfigure $handle -encoding utf-8
    set config [read $handle]
    close $handle
    if {[regexp {omdb\.api_key[ \t]+"([^"]+)"} $config -> apiKey]} {
        return [string trim $apiKey]
    }
    return ""
}

proc ::ioNiNJA::ioTVDB::https_socket {verify args} {
    set socketArgs {}
    foreach arg $args {
        if {$arg ne "-async"} {lappend socketArgs $arg}
    }
    return [::tls::socket -autoservername 1 -require $verify {*}$socketArgs]
}

proc ::ioNiNJA::ioTVDB::ensure_http {} {
    global ioTVDB
    variable HttpsRegistered

    if {[catch {package require http} error]} {
        return "Tcl http package is unavailable: $error"
    }
    if {[catch {package require tls} error]} {
        return "Tcl tls package is unavailable: $error"
    }
    if {!$HttpsRegistered} {
        ::http::register https 443 [list ::ioNiNJA::ioTVDB::https_socket $ioTVDB(omdb_tls_verify)]
        set HttpsRegistered 1
    }
    return ""
}

proc ::ioNiNJA::ioTVDB::build_url {query {season ""} {episode ""}} {
    global ioTVDB
    set params [list apikey [load_api_key] plot short r json]
    if {[regexp -nocase {^tt[0-9]+$} $query]} {
        lappend params i $query
    } else {
        lappend params t $query type series
    }
    if {$season ne "" && $episode ne ""} {
        lappend params Season $season Episode $episode
    }
    return "[string trimright $ioTVDB(omdb_endpoint) ?]?[::http::formatQuery {*}$params]"
}

proc ::ioNiNJA::ioTVDB::fetch {query {season ""} {episode ""}} {
    global ioTVDB
    variable Cache

    if {[load_api_key] eq ""} {
        return [dict create ok 0 error "OMDb API key is missing"]
    }
    set packageError [ensure_http]
    if {$packageError ne ""} {
        return [dict create ok 0 error $packageError]
    }

    set cacheKey [string tolower "$query|$season|$episode"]
    set now [clock seconds]
    if {[dict exists $Cache $cacheKey]} {
        lassign [dict get $Cache $cacheKey] timestamp data
        if {$now - $timestamp < $ioTVDB(omdb_cache_seconds)} {
            return [dict create ok 1 data $data]
        }
        dict unset Cache $cacheKey
    }

    set token ""
    if {[catch {
        set token [::http::geturl [build_url $query $season $episode] -timeout $ioTVDB(omdb_timeout_ms)]
        set status [::http::status $token]
        set code [::http::ncode $token]
        set body [::http::data $token]
    } error]} {
        if {$token ne ""} {catch {::http::cleanup $token}}
        return [dict create ok 0 error $error]
    }
    ::http::cleanup $token
    if {$status ne "ok" || $code < 200 || $code >= 300} {
        return [dict create ok 0 error "HTTP status $status ($code)"]
    }
    dict set Cache $cacheKey [list $now $body]
    return [dict create ok 1 data $body]
}

proc ::ioNiNJA::ioTVDB::lookup {query {season ""} {episode ""}} {
    set fetched [fetch $query $season $episode]
    if {![dict get $fetched ok]} {return $fetched}
    if {[catch {set data [json_to_dict [dict get $fetched data]]} error]} {
        return [dict create ok 0 error "OMDb response parse failed: $error"]
    }
    if {[dict_get $data Response "False"] ne "True"} {
        return [dict create ok 0 error [dict_get $data Error "OMDb lookup failed"]]
    }
    return [dict create ok 1 title $data]
}

proc ::ioNiNJA::ioTVDB::parse_release {release} {
    set rel [file tail $release]
    set matched [regexp -nocase {^(.*?)[._ -]+s([0-9]{1,2})[._ -]*e([0-9]{1,3})(?:[._ -]|$)} $rel -> show season episode]
    if {!$matched} {
        set matched [regexp -nocase {^(.*?)[._ -]+([0-9]{1,2})x([0-9]{1,3})(?:[._ -]|$)} $rel -> show season episode]
    }
    if {$matched} {
        set season [decimal_number $season]
        set episode [decimal_number $episode]
        set show [string trim [regsub -all {[._]+} $show " "]]
        return [dict create kind episode show $show season $season episode $episode]
    }
    if {[regexp -nocase {^(.*?)[._ -]+(20[0-9]{2})[._ -]([0-1][0-9])[._ -]([0-3][0-9])} $rel -> show year month day]} {
        set show [string trim [regsub -all {[._]+} $show " "]]
        return [dict create kind date show $show date "$year-$month-$day"]
    }
    return [dict create kind none show "" season "" episode ""]
}

proc ::ioNiNJA::ioTVDB::decimal_number {number} {
    set decimal [string trimleft $number 0]
    if {$decimal eq ""} {return 0}
    return [expr {wide($decimal)}]
}

proc ::ioNiNJA::ioTVDB::map_show {show} {
    global ioTVDB
    foreach rule [split [string trim $ioTVDB(regexp_show)] \n] {
        lassign $rule pattern replacement
        if {[regexp -nocase $pattern $show]} {return $replacement}
    }
    return $show
}

proc ::ioNiNJA::ioTVDB::safe_component {value} {
    regsub -all {[/\\:*?"<>|]} $value {} value
    return [string trim $value]
}

proc ::ioNiNJA::ioTVDB::split_field {value} {
    if {$value eq "" || $value eq "N/A"} {return [list Unknown]}
    set result {}
    foreach item [split $value ,] {lappend result [string trim $item]}
    return $result
}

proc ::ioNiNJA::ioTVDB::screw_octal {number} {
    if {$number eq ""} {return ""}
    return [format %02d [decimal_number $number]]
}

proc ::ioNiNJA::ioTVDB::sort_no_info {rel currentPwd episode season showName} {
    global ioTVDB path
    set group [get_grpname $rel]
    foreach rule [split [string trim $ioTVDB(sorting_no_lookup)] \n] {
        lassign $rule pwdPattern target
        if {![regexp -nocase $pwdPattern $currentPwd]} {continue}
        set firstLetter [string toupper [string index $showName 0]]
        if {![regexp {[A-Z0-9]} $firstLetter]} {set firstLetter "#"}
        set item [string map [list \
            %group_name [safe_component $group] %first_letter $firstLetter \
            %release [safe_component $rel] %epnum $episode %epseason $season \
            %showname [safe_component $showName]] $target]
        sorting $ioTVDB(sym_type) $path $item $currentPwd
    }
}

proc ::ioNiNJA::ioTVDB::sort_no_info_date {rel currentPwd date showName} {
    global ioTVDB path
    set group [get_grpname $rel]
    foreach rule [split [string trim $ioTVDB(sorting_no_lookup_date)] \n] {
        lassign $rule pwdPattern target
        if {![regexp -nocase $pwdPattern $currentPwd]} {continue}
        set firstLetter [string toupper [string index $showName 0]]
        if {![regexp {[A-Z0-9]} $firstLetter]} {set firstLetter "#"}
        set item [string map [list \
            %release_group [safe_component $group] %first_letter $firstLetter \
            %release [safe_component $rel] %date $date \
            %showname [safe_component $showName]] $target]
        sorting $ioTVDB(sym_type) $path $item $currentPwd
    }
}

proc ::ioNiNJA::ioTVDB::tv_sorting {values} {
    global ioTVDB
    foreach name {
        rel currentPwd realPath episode season epdirector epname epfirstAired
        epplot epRating epWriter showRating status showName runtime overview
        network genres premiere airtime airday actors
    } {set $name [dict get $values $name]}

    set group [get_grpname $rel]
    foreach rule [split [string trim $ioTVDB(sorting)] \n] {
        lassign $rule pwdPattern target
        if {![regexp -nocase $pwdPattern $currentPwd]} {continue}
        set targets [list [string map [list \
            %release_group [safe_component $group] %show_name [safe_component $showName] \
            %epseason $season %epnum $episode %epdirector [safe_component $epdirector] \
            %epname [safe_component $epname] %epfirst_aired [safe_component $epfirstAired] \
            %epplot [safe_component $epplot] %eprating [safe_component $epRating] \
            %epwriter [safe_component $epWriter] %plot [safe_component $overview] \
            %runtime [safe_component $runtime] %status [safe_component $status] \
            %showrating [safe_component $showRating] %airday [safe_component $airday] \
            %airtime [safe_component $airtime] %firstaired [safe_component $premiere] \
            %network [safe_component $network] %release [safe_component $rel]] $target]]

        foreach expansion {{%genre genres} {%actor actors}} {
            lassign $expansion cookie fieldName
            if {![string match "*$cookie*" $target]} {continue}
            set expanded {}
            foreach current $targets {
                foreach value [dict get $values $fieldName] {
                    set value [safe_component $value]
                    set mapping [list $cookie $value]
                    if {$fieldName eq "actors"} {
                        lappend mapping %actor_first_letter [string toupper [string index $value 0]]
                    }
                    lappend expanded [string map $mapping $current]
                }
            }
            set targets $expanded
        }
        foreach item $targets {sorting $ioTVDB(sym_type) $realPath $item $currentPwd}
    }
}

proc ::ioNiNJA::ioTVDB::download_poster {url destination} {
    global ioTVDB
    if {$url eq "" || $url eq "N/A" || [file exists $destination] && !$ioTVDB(DELETE_OLD_POSTER)} {
        return
    }
    set token ""
    if {[catch {
        set token [::http::geturl $url -binary 1 -timeout $ioTVDB(omdb_timeout_ms)]
        if {[::http::ncode $token] < 200 || [::http::ncode $token] >= 300} {
            error "poster HTTP status [::http::ncode $token]"
        }
        set image [::http::data $token]
    }]} {
        if {$token ne ""} {catch {::http::cleanup $token}}
        return
    }
    ::http::cleanup $token
    if {![catch {set handle [open $destination wb]}]} {
        fconfigure $handle -translation binary
        puts -nonewline $handle $image
        close $handle
    }
}

proc ::ioNiNJA::ioTVDB::store_info {rel series episodeData season episode} {
    global ioTVDB ioNJ pwd path args uid gid

    set showName [dict_get $series Title]
    set overview [dict_get $series Plot "Unknown"]
    set runtime [dict_get $series Runtime "Unknown"]
    set showRating [dict_get $series imdbRating "N/A"]
    set actors [split_field [dict_get $series Actors]]
    set genres [split_field [dict_get $series Genre]]
    set premiere [dict_get $series Released [dict_get $series Year "Unknown"]]
    set imdbID [dict_get $series imdbID]
    set seriesUrl "https://www.imdb.com/title/$imdbID/"
    set status "N/A"
    set network "N/A"
    set airtime "N/A"
    set airday "N/A"

    set epname [dict_get $episodeData Title "Unknown"]
    set epdirector [dict_get $episodeData Director "Unknown"]
    set epfirstAired [dict_get $episodeData Released "Unknown"]
    set epplot [dict_get $episodeData Plot "Unknown"]
    set epRating [dict_get $episodeData imdbRating "N/A"]
    set epWriter [dict_get $episodeData Writer "Unknown"]
    set season [screw_octal [dict_get $episodeData Season $season]]
    set episode [screw_octal [dict_get $episodeData Episode $episode]]

    set values [dict create \
        rel $rel currentPwd $pwd realPath $path episode $episode season $season \
        epdirector $epdirector epname $epname epfirstAired $epfirstAired \
        epplot $epplot epRating $epRating epWriter $epWriter showRating $showRating \
        status $status showName $showName runtime $runtime overview $overview \
        network $network genres $genres premiere $premiere airtime $airtime \
        airday $airday actors $actors]
    tv_sorting $values

    set barMap [list \
        %show_name $showName %epseason $season %epnum $episode \
        %epdirector $epdirector %epname $epname %epfirst_aired $epfirstAired \
        %epplot $epplot %eprating $epRating %epwriter $epWriter %plot $overview \
        %runtime $runtime %status $status %showrating $showRating \
        %actors [join $actors {, }] %airday $airday %airtime $airtime \
        %firstaired $premiere %genre [join $genres {, }] %network $network]
    set barName [string map $barMap $ioTVDB(INFO_BAR)]
    regsub -all {[/\\:*?"<>|]} $barName {} barName
    foreach old [glob -nocomplain -directory $path [string map {\[ \\[ \] \\]} $ioTVDB(info_del_bar)]] {
        catch {file delete -force $old}
    }
    set barPath [file join $path $barName]
    if {$ioTVDB(info_bar_type) == 1} {
        if {![catch {set handle [open $barPath w]}]} {close $handle}
    } else {
        catch {file mkdir $barPath}
    }

    if {$ioTVDB(MAX_POSTER_TYPE) != 0} {
        download_poster [dict_get $series Poster] [file join $path folder.jpg]
    }
    if {$ioNJ(tv_get_html) ne ""} {
        set htmlName [string map [list %release $rel] $ioNJ(tv_get_html)]
        if {![catch {set handle [open [file join $path $htmlName] w]}]} {
            puts $handle "<TITLE>IMDb TV redirect</TITLE>"
            puts $handle "<META HTTP-EQUIV=\"refresh\" CONTENT=\"0;URL=$seriesUrl\">"
            close $handle
        }
    }

    set tvInfo [list 1 $showName $season $episode $epdirector $epname \
        $epfirstAired $epplot $epRating $epWriter $overview $runtime $status \
        $showRating [join $actors {, }] $airday $airtime $premiere \
        [join $genres {, }] $network $seriesUrl]
    writechattr 30 $tvInfo
    if {$args ne "RESCAN"} {put_log "TheTVDB: [list $pwd {*}[lrange $tvInfo 1 end]]"}
}

proc ::ioNiNJA::ioTVDB::TV_MKD {} {
    global pwd path args ioTVDB

    set target [lindex $args 2]
    # exec_on_nfo starts this file in a fresh interpreter.  The bootstrap at
    # the end of the file has already derived pwd in that case and removes the
    # physical filename from args, so there may no longer be an args element 2.
    if {$target eq ""} {
        set target $pwd
    }

    if {[regexp {/} $target]} {
        set pwd $target
    } else {
        set pwd [file join $pwd $target]
    }
    if {[catch {set path [resolve pwd $pwd]} error]} {
        putlog "ERROR ioTV: cannot resolve virtual path '$pwd' ($error)"
        return
    }
    if {![regexp -nocase $ioTVDB(PATHS) $pwd]} {return}

    set rel [file tail [string trimright $pwd /]]
    if {$ioTVDB(skiplist) ne "" && [regexp -nocase $ioTVDB(skiplist) $rel]} {return}
    set parsed [parse_release $rel]
    set kind [dict get $parsed kind]
    if {$kind eq "none"} {return}
    set show [map_show [dict get $parsed show]]

    if {$kind eq "date"} {
        sort_no_info_date $rel $pwd [dict get $parsed date] $show
        return
    }

    set season [dict get $parsed season]
    set episode [dict get $parsed episode]
    if {$ioTVDB(sort_no_lookup) ne "" && [regexp -nocase $ioTVDB(sort_no_lookup) $rel]} {
        sort_no_info $rel $pwd [screw_octal $episode] [screw_octal $season] $show
        return
    }

    foreach rule [split [string trim $ioTVDB(special_regexp_sorting)] \n] {
        if {[llength $rule] != 3} {continue}
        lassign $rule pwdPattern relPattern targets
        if {[regexp -nocase $pwdPattern $pwd] && [regexp -nocase $relPattern $rel]} {
            set group [get_grpname $rel]
            foreach target $targets {
                sorting $ioTVDB(sym_type) $path [string map [list %release $rel %group $group] $target] $pwd
            }
            return
        }
    }

    iputs -nobuffer "ioTV/OMDb: $show S[screw_octal $season]E[screw_octal $episode]"
    set seriesResult [lookup $show]
    if {![dict get $seriesResult ok]} {
        putlog "ERROR ioTV/OMDb: $pwd - [dict get $seriesResult error]"
        sort_no_info $rel $pwd [screw_octal $episode] [screw_octal $season] $show
        return
    }
    set series [dict get $seriesResult title]
    set episodeResult [lookup [dict_get $series imdbID] $season $episode]
    if {![dict get $episodeResult ok]} {
        putlog "ERROR ioTV/OMDb episode: $pwd - [dict get $episodeResult error]"
        set episodeData [dict create]
    } else {
        set episodeData [dict get $episodeResult title]
    }
    store_info $rel $series $episodeData $season $episode
}

proc ::ioNiNJA::ioTVDB::SCAN_SERIES {} {
    iputs -nobuffer "ioTV/OMDb: scan uses live lookups; no TVDB cache is required"
}

proc ::ioNiNJA::ioTVDB::UPDATING {} {
    iputs -nobuffer "ioTV/OMDb: no scheduled provider cache update is required"
}

if {![info exists pwd]} {
    set pwd [file dirname [lindex $args 2]]
    set path [file dirname [lindex $args 0]]
    set args [lrange $args 1 end]
    ::ioNiNJA::ioTVDB::TV_MKD
    return
}

switch -- [lindex $args 0] {
    MKD {::ioNiNJA::ioTVDB::TV_MKD}
    SCAN_SERIES {::ioNiNJA::ioTVDB::SCAN_SERIES}
    UPDATE_SERIES {::ioNiNJA::ioTVDB::UPDATING}
}
